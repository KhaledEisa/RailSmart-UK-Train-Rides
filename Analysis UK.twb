      </column>
      <column datatype='integer' name='[Is_Delayed]' role='measure' type='quantitative' />
      <column datatype='string' name='[Journey Status]' role='dimension' type='nominal' />
      <column datatype='string' name='[Journey_DayName]' role='dimension' type='nominal' />
      <column caption='On Time Flag' datatype='integer' default-format='p0.0%' name='[On Time Flag]' role='measure' type='quantitative'>
