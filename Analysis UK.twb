      <column caption='Refund_Requested' datatype='integer' default-format='#,##0' name='[Refund_Requested]' role='measure' type='quantitative' />
      <column caption='Revenue' datatype='integer' default-format='&quot;£&quot;#,##0' name='[Revenue]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price]' />
      </column>
      <column aggregation='Avg' caption='Station Latitude' datatype='real' name='[Station Latitude]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative'>
        <calculation class='tableau' formula='CASE [Departure Station] WHEN &quot;Birmingham New Street&quot; THEN 52.4778 WHEN &quot;Bristol Temple Meads&quot; THEN 51.4492 WHEN &quot;Cardiff Central&quot; THEN 51.4759 WHEN &quot;Coventry&quot; THEN 52.4008 WHEN &quot;Crewe&quot; THEN 53.0897 WHEN &quot;Didcot&quot; THEN 51.6112 WHEN &quot;Doncaster&quot; THEN 53.5218 WHEN &quot;Durham&quot; THEN 54.7794 WHEN &quot;Edinburgh&quot; THEN 55.9521 WHEN &quot;Edinburgh Waverley&quot; THEN 55.9521 WHEN &quot;Leeds&quot; THEN 53.7955 WHEN &quot;Leicester&quot; THEN 52.6312 WHEN &quot;Liverpool Lime Street&quot; THEN 53.4076 WHEN &quot;London Euston&quot; THEN 51.5282 WHEN &quot;London Kings Cross&quot; THEN 51.532 WHEN &quot;London Paddington&quot; THEN 51.5154 WHEN &quot;London St Pancras&quot; THEN 51.5308 WHEN &quot;London Waterloo&quot; THEN 51.5031 WHEN &quot;Manchester Piccadilly&quot; THEN 53.4775 WHEN &quot;Nottingham&quot; THEN 52.947 WHEN &quot;Nuneaton&quot; THEN 52.5225 WHEN &quot;Oxford&quot; THEN 51.7535 WHEN &quot;Peterborough&quot; THEN 52.5748 WHEN &quot;Reading&quot; THEN 51.4589 WHEN &quot;Sheffield&quot; THEN 53.3781 WHEN &quot;Stafford&quot; THEN 52.8021 WHEN &quot;Swindon&quot; THEN 51.5654 WHEN &quot;Tamworth&quot; THEN 52.6349 WHEN &quot;Wakefield&quot; THEN 53.682 WHEN &quot;Warrington&quot; THEN 53.39 WHEN &quot;Wolverhampton&quot; THEN 52.5877 WHEN &quot;York&quot; THEN 53.958 END' />
      </column>
      <column aggregation='Avg' caption='Station Longitude' datatype='real' name='[Station Longitude]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative'>
        <calculation class='tableau' formula='CASE [Departure Station] WHEN &quot;Birmingham New Street&quot; THEN -1.8988 WHEN &quot;Bristol Temple Meads&quot; THEN -2.5814 WHEN &quot;Cardiff Central&quot; THEN -3.1791 WHEN &quot;Coventry&quot; THEN -1.5132 WHEN &quot;Crewe&quot; THEN -2.4331 WHEN &quot;Didcot&quot; THEN -1.2431 WHEN &quot;Doncaster&quot; THEN -1.141 WHEN &quot;Durham&quot; THEN -1.5798 WHEN &quot;Edinburgh&quot; THEN -3.1896 WHEN &quot;Edinburgh Waverley&quot; THEN -3.1896 WHEN &quot;Leeds&quot; THEN -1.5491 WHEN &quot;Leicester&quot; THEN -1.1252 WHEN &quot;Liverpool Lime Street&quot; THEN -2.9779 WHEN &quot;London Euston&quot; THEN -0.1337 WHEN &quot;London Kings Cross&quot; THEN -0.1233 WHEN &quot;London Paddington&quot; THEN -0.1755 WHEN &quot;London St Pancras&quot; THEN -0.126 WHEN &quot;London Waterloo&quot; THEN -0.1132 WHEN &quot;Manchester Piccadilly&quot; THEN -2.2311 WHEN &quot;Nottingham&quot; THEN -1.146 WHEN &quot;Nuneaton&quot; THEN -1.468 WHEN &quot;Oxford&quot; THEN -1.27 WHEN &quot;Peterborough&quot; THEN -0.2497 WHEN &quot;Reading&quot; THEN -0.972 WHEN &quot;Sheffield&quot; THEN -1.462 WHEN &quot;Stafford&quot; THEN -2.1215 WHEN &quot;Swindon&quot; THEN -1.7855 WHEN &quot;Tamworth&quot; THEN -1.692 WHEN &quot;Wakefield&quot; THEN -1.503 WHEN &quot;Warrington&quot; THEN -2.6 WHEN &quot;Wolverhampton&quot; THEN -2.12 WHEN &quot;York&quot; THEN -1.093 END' />
      </column>
      <column caption='Ticket Price' datatype='real' default-format='&quot;£&quot;#,##0.00' name='[Ticket Price]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([Price])' />
      </column>
      <column datatype='string' name='[Transaction ID]' role='dimension' type='nominal' />
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column-instance column='[Is_Delayed]' derivation='Avg' name='[avg:Is_Delayed:qk]' pivot='key' type='quantitative' />
      <column-instance column='[Transaction ID]' derivation='Count' name='[cnt:Transaction ID:qk]' pivot='key' type='quantitative' />
