      </column>
      <column caption='Delay Mins Delayed Only' datatype='real' default-format='#,##0.0' name='[Delay Mins Delayed Only]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Is_Delayed] = 1, [Delay_Minutes], NULL)' />
      </column>
      <column caption='Delay_Minutes' datatype='real' default-format='#,##0.0' name='[Delay_Minutes]' role='measure' type='quantitative' />
      <column caption='Delayed Flag' datatype='integer' default-format='p0.0%' name='[Delayed Flag]' role='measure' type='quantitative'>
