            <shelf-sort-v2 dimension-to-sort='[federated.railway_cleaned].[none:Route:nk]' direction='ASC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.railway_cleaned].[sum:Revenue:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
